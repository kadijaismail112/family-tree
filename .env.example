NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Needed by the nightly storage reaper (and the dev login route).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`.
# Without it the reaper route refuses to run.
CRON_SECRET=a-long-random-string

# Local only, and optional. Enables the "skip login" button on the auth forms
# by creating/resetting a dev@example.com account with this password. Pick
# something only you know and never set it in a deployed environment — the
# account it creates is real and can sign in to the live site.
DEV_LOGIN_PASSWORD=
